{
  "name": "@nexus/storage-browser",
  "version": "0.1.0",
  "description": "Headless Nexus storage client + explorer/mount model (buckets, capability fallbacks, mount plan) shared by the desktop app, the mobile app, the nexus CLI and the mount daemon",
  "license": "UNLICENSED",
  "publishConfig": { "access": "public" },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nexus/files-core": "file:../files-core"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
